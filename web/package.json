{
  "name": "ph-restaurant-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "deploy:demo": "vite build --mode demo && rm -rf ../docs/assets ../docs/index.html ../docs/icon.svg && cp -r dist-demo/. ../docs/ && touch ../docs/.nojekyll",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "apk": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "sql.js": "^1.16.0",
    "vite": "^8.3.8"
  }
}
